
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Retailer Order List View -->
    <record id="view_retailer_order_list" model="ir.ui.view">
        <field name="name">retailer.order.list</field>
        <field name="model">retailer.order</field>
        <field name="arch" type="xml">
            <list string="Retailer Orders"
                  decoration-success="state == 'delivered'"
                  decoration-info="state == 'processing'"
                  decoration-warning="state == 'ready_to_ship'"
                  decoration-danger="state == 'cancelled'">

                <field name="name"/>
                <field name="retailer_id"/>
                <field name="order_date"/>
                <field name="order_taken_by"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="shipping_employee_id"/>
                <field name="state" widget="badge"/>

            </list>
        </field>
    </record>


    <!-- Retailer Order Form View -->
    <record id="view_retailer_order_form" model="ir.ui.view">
        <field name="name">retailer.order.form</field>
        <field name="model">retailer.order</field>
        <field name="arch" type="xml">

            <form string="Retailer Order">

                <header>

                    <button name="action_start_processing"
                            string="Start Processing"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'new'"/>

                    <button name="action_add_products"
                            string="Add Products to Cart"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'processing'"/>

                    <button name="action_ready_to_ship"
                            string="Ready to Ship"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'adding_products'"/>

                    <button name="action_start_shipping"
                            string="Start Shipping"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'ready_to_ship'"/>

                    <button name="action_dispatch"
                            string="Mark Dispatched"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'shipping'"/>

                    <button name="action_deliver"
                            string="Confirm Delivery"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'dispatched'"/>

                    <button name="action_cancel"
                            string="Cancel Order"
                            type="object"
                            class="btn-secondary"
                            invisible="state in ('cancelled', 'dispatched', 'delivered')"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,processing,adding_products,ready_to_ship,shipping,dispatched,delivered"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Order Information">
                            <field name="retailer_id"/>
                            <field name="order_date"/>
                            <field name="order_taken_by"/>
                        </group>

                        <group string="Shipping Information">
                            <field name="shipping_employee_id"/>
                            <field name="dispatch_date" readonly="1"/>
                            <field name="delivery_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Products">
                            <field name="order_line_ids"
                                   readonly="state not in ('new', 'processing', 'adding_products')">

                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>

                            </field>
                        </page>
                    </notebook>

                    <group>
                        <group/>
                        <group>
                            <field name="total_amount"/>
                        </group>
                    </group>

                </sheet>

            </form>

        </field>
    </record>


    <!-- Connect List and Form Views to Dashboard Action -->
    <record id="action_retailer_order_dashboard_list_view"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_retailer_order_list"/>
        <field name="act_window_id" ref="action_retailer_order_dashboard"/>
    </record>

    <record id="action_retailer_order_dashboard_form_view"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_retailer_order_form"/>
        <field name="act_window_id" ref="action_retailer_order_dashboard"/>
    </record>

</odoo>