
<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Order List -->
    <record id="view_my_app_order_list" model="ir.ui.view">
        <field name="name">my_app.order.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="Retailer Orders"
                  default_order="create_date desc"
                  decoration-info="state == 'new'"
                  decoration-warning="state == 'on_hold'"
                  decoration-success="state == 'shipped'">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="create_date"/>
                <field name="write_date"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Basic Order Search: No Filters or Group By -->
    <record id="view_my_app_order_search" model="ir.ui.view">
        <field name="name">my_app.order.search</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <search string="Search Retailer Orders">
                <field name="name" string="Order Number"/>
                <field name="retailer_id" string="Retailer"/>
                <field name="assigned_user_id" string="Assigned Staff"/>
                <field name="department" string="Department"/>
                <field name="state" string="Status"/>
            </search>
        </field>
    </record>

    <!-- Order Form -->
    <record id="view_my_app_order_form" model="ir.ui.view">
        <field name="name">my_app.order.form</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <form string="Retailer Order">
                <header>
                    <button name="action_claim_order"
                            type="object"
                            string="Claim Order"
                            class="btn-primary"
                            invisible="assigned_user_id != False"/>

                    <button name="action_start_inventory_check"
                            type="object"
                            string="Start Inventory Check"
                            invisible="state != 'new'"/>

                    <button name="action_inventory_checked"
                            type="object"
                            string="Inventory Checked"
                            class="btn-primary"
                            invisible="state != 'checking_inventory'"/>

                    <button name="action_start_processing"
                            type="object"
                            string="Start Processing"
                            invisible="state != 'inventory_checked'"/>

                    <button name="action_complete_processing"
                            type="object"
                            string="Complete Processing"
                            class="btn-primary"
                            invisible="state != 'processing'"/>

                    <button name="action_put_on_hold"
                            type="object"
                            string="Put On Hold"
                            invisible="state in ('completed', 'shipped', 'on_hold')"/>

                    <button name="action_resume_order"
                            type="object"
                            string="Resume"
                            invisible="state != 'on_hold'"/>

                    <button name="action_ready_to_ship"
                            type="object"
                            string="Ready to Ship"
                            invisible="state != 'completed'"/>

                    <button name="action_mark_shipped"
                            type="object"
                            string="Mark Shipped"
                            invisible="state != 'ready_to_ship'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,checking_inventory,inventory_checked,processing,completed,ready_to_ship,shipped"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="retailer_id"/>
                            <field name="department"/>
                            <field name="assigned_user_id"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="True"/>
                            <field name="write_date" readonly="True"/>
                            <field name="amount_total" readonly="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"
                                           options="{'no_create': True}"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="subtotal" readonly="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Hold Details">
                            <field name="hold_reason"
                                   placeholder="Explain why this order is on hold..."/>
                        </page>

                        <page string="Status History">
                            <field name="history_ids" readonly="True">
                                <list create="False"
                                      edit="False"
                                      delete="False"
                                      default_order="changed_on desc">
                                    <field name="changed_on"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="changed_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Order Action -->
    <record id="action_my_app_orders" model="ir.actions.act_window">
        <field name="name">Retailer Orders</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_my_app_order_search"/>
    </record>

    <!-- Orders Menu -->
    <menuitem id="menu_my_app_orders"
              name="Retailer Orders"
              parent="menu_my_app_root"
              action="action_my_app_orders"
              sequence="20"/>

</odoo>
