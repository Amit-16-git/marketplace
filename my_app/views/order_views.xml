<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_my_app_order_list" model="ir.ui.view">
        <field name="name">my_app.order.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="Retailer Orders">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="create_date"/>
                <field name="write_date"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="amount_total"/>
                <field name="is_pending"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_my_app_order_search" model="ir.ui.view">
        <field name="name">my_app.order.search</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <search string="Search Retailer Orders">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="state"/>

                <filter name="filter_pending"
                        string="Pending Orders"
                        domain="[('is_pending', '=', True)]"/>

                <separator/>

                <filter name="filter_new"
                        string="New"
                        domain="[('state', '=', 'new')]"/>
                <filter name="filter_processing"
                        string="Processing"
                        domain="[('state', '=', 'processing')]"/>
                <filter name="filter_adding_products"
                        string="Adding Products"
                        domain="[('state', '=', 'adding_products')]"/>
                <filter name="filter_ready_to_ship"
                        string="Ready to Ship"
                        domain="[('state', '=', 'ready_to_ship')]"/>
                <filter name="filter_dispatched"
                        string="Dispatched"
                        domain="[('state', '=', 'dispatched')]"/>
                <filter name="filter_delivered"
                        string="Delivered"
                        domain="[('state', '=', 'delivered')]"/>
            </search>
        </field>
    </record>

    <record id="view_my_app_order_form" model="ir.ui.view">
        <field name="name">my_app.order.form</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <form string="Retailer Order">
                <header>
                    <button name="action_claim_order"
                            type="object"
                            string="Claim Order"
                            invisible="is_pending or (assigned_user_id != False and assigned_user_id != uid)"/>

                    <button name="action_pending_order"
                            type="object"
                            string="Pending Order"
                            class="btn-secondary"
                            invisible="is_pending or state == 'delivered'"/>

                    <button name="action_resume_order"
                            type="object"
                            string="Resume Order"
                            class="btn-primary"
                            invisible="not is_pending"/>

                    <button name="action_start_processing"
                            type="object"
                            string="Start Processing"
                            class="btn-primary"
                            invisible="is_pending or state != 'new'"/>

                    <button name="action_add_products"
                            type="object"
                            string="Add Products"
                            class="btn-primary"
                            invisible="is_pending or state != 'processing'"/>

                    <button name="action_ready_to_ship"
                            type="object"
                            string="Ready to Ship"
                            class="btn-primary"
                            invisible="is_pending or state != 'adding_products'"/>

                    <button name="action_dispatch"
                            type="object"
                            string="Dispatch"
                            class="btn-primary"
                            invisible="is_pending or state != 'ready_to_ship'"/>

                    <button name="action_deliver"
                            type="object"
                            string="Mark Delivered"
                            class="btn-primary"
                            invisible="is_pending or state != 'dispatched'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,processing,adding_products,ready_to_ship,dispatched,delivered"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Order Information">
                            <field name="retailer_id"/>
                            <field name="department"/>
                            <field name="assigned_user_id"/>
                            <field name="is_pending" readonly="True"/>
                        </group>
                        <group string="Dates and Totals">
                            <field name="create_date" readonly="True"/>
                            <field name="write_date" readonly="True"/>
                            <field name="amount_total" readonly="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids"
                                   readonly="is_pending or state in ['ready_to_ship', 'dispatched', 'delivered']">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="subtotal" readonly="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Status History">
                            <field name="history_ids" readonly="True">
                                <list>
                                    <field name="changed_on"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="changed_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_my_app_orders" model="ir.actions.act_window">
        <field name="name">Retailer Orders</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_my_app_order_list"/>
        <field name="search_view_id" ref="view_my_app_order_search"/>
    </record>

    <menuitem id="menu_my_app_orders"
              name="Retailer Orders"
              parent="menu_my_app_root"
              action="action_my_app_orders"
              sequence="20"
              groups="base.group_system,my_app.group_my_app_manager"/>

</odoo>
