<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- RETAILER ORDER LIST -->
    <record id="view_my_app_order_list" model="ir.ui.view">
        <field name="name">my_app.order.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="Retailer Orders">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="create_date"/>
                <field name="write_date"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- RETAILER ORDER SEARCH -->
    <record id="view_my_app_order_search" model="ir.ui.view">
        <field name="name">my_app.order.search</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <search string="Search Retailer Orders">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="state"/>

                <filter name="filter_new"
                        string="New"
                        domain="[('state', '=', 'new')]"/>

                <filter name="filter_checking_inventory"
                        string="Checking Inventory"
                        domain="[('state', '=', 'checking_inventory')]"/>

                <filter name="filter_inventory_checked"
                        string="Inventory Checked"
                        domain="[('state', '=', 'inventory_checked')]"/>

                <filter name="filter_pending_stock"
                        string="Pending Stock"
                        domain="[('state', '=', 'pending_stock')]"/>

                <filter name="filter_processing"
                        string="Processing"
                        domain="[('state', '=', 'processing')]"/>

                <filter name="filter_completed"
                        string="Completed"
                        domain="[('state', '=', 'completed')]"/>

                <filter name="filter_on_hold"
                        string="On Hold"
                        domain="[('state', '=', 'on_hold')]"/>

                <filter name="filter_ready_to_ship"
                        string="Ready to Ship"
                        domain="[('state', '=', 'ready_to_ship')]"/>

                <filter name="filter_shipped"
                        string="Shipped"
                        domain="[('state', '=', 'shipped')]"/>
            </search>
        </field>
    </record>

    <!-- RETAILER ORDER FORM -->
    <record id="view_my_app_order_form" model="ir.ui.view">
        <field name="name">my_app.order.form</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <form string="Retailer Order">
                <header>
                    <button name="action_claim_order"
                            type="object"
                            string="Claim Order"
                            class="btn-primary"/>

                    <button name="action_start_inventory_check"
                            type="object"
                            string="Start Inventory Check"
                            class="btn-primary"/>

                    <button name="action_inventory_checked"
                            type="object"
                            string="Inventory Checked"
                            class="btn-primary"/>

                    <button name="action_pending_stock"
                            type="object"
                            string="Pending Stock"/>

                    <button name="action_start_processing"
                            type="object"
                            string="Start Processing"
                            class="btn-primary"/>

                    <button name="action_complete_processing"
                            type="object"
                            string="Complete Processing"
                            class="btn-primary"/>

                    <button name="action_put_on_hold"
                            type="object"
                            string="Put On Hold"/>

                    <button name="action_resume_order"
                            type="object"
                            string="Resume Order"/>

                    <button name="action_ready_to_ship"
                            type="object"
                            string="Ready to Ship"
                            class="btn-primary"/>

                    <button name="action_mark_shipped"
                            type="object"
                            string="Mark Shipped"
                            class="btn-primary"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,checking_inventory,inventory_checked,pending_stock,processing,completed,on_hold,ready_to_ship,shipped"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Order Information">
                            <field name="retailer_id"/>
                            <field name="department"/>
                            <field name="assigned_user_id"/>
                        </group>

                        <group string="Dates and Totals">
                            <field name="create_date" readonly="True"/>
                            <field name="write_date" readonly="True"/>
                            <field name="amount_total" readonly="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="subtotal" readonly="True"/>
                                </list>
                            </field>
                        </page>

                        <page string="Hold Details">
                            <field name="hold_reason"
                                   placeholder="Enter the reason for putting this order on hold..."/>
                        </page>

                        <page string="Status History">
                            <field name="history_ids" readonly="True">
                                <list>
                                    <field name="changed_on"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="changed_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- MANAGER / ADMIN: ALL ORDERS -->
    <record id="action_my_app_orders" model="ir.actions.act_window">
        <field name="name">Retailer Orders</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_my_app_order_list"/>
        <field name="search_view_id" ref="view_my_app_order_search"/>
    </record>

    <!-- INVENTORY STAFF: NON-SHIPPING STATUSES ONLY -->
    <record id="action_my_app_orders_inventory" model="ir.actions.act_window">
        <field name="name">Retailer Orders</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_my_app_order_list"/>
        <field name="search_view_id" ref="view_my_app_order_search"/>
        <field name="domain">[('state', 'in', ['new', 'checking_inventory', 'inventory_checked', 'pending_stock', 'processing', 'completed', 'on_hold'])]</field>
    </record>

    <!-- MANAGER / ADMIN MENU -->
    <menuitem id="menu_my_app_orders"
              name="Retailer Orders"
              parent="menu_my_app_root"
              action="action_my_app_orders"
              sequence="20"
              groups="base.group_system,my_app.group_my_app_manager"/>

    <!-- INVENTORY STAFF MENU -->
    <menuitem id="menu_my_app_orders_inventory"
              name="Retailer Orders"
              parent="menu_my_app_root"
              action="action_my_app_orders_inventory"
              sequence="21"
              groups="my_app.group_my_app_inventory"/>

</odoo>
