<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Management Dashboard List View -->
    <record id="view_my_app_dashboard_list" model="ir.ui.view">
        <field name="name">my_app.order.dashboard.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="Management Dashboard"
                  create="false"
                  edit="false"
                  delete="false">

                <field name="retailer_id" string="Retailer Name"/>
                <field name="create_date" string="Created Time"/>
                <field name="write_date" string="Updated Time"/>
                <field name="state" string="Status"/>

            </list>
        </field>
    </record>

    <!-- Management Dashboard Action -->
    <record id="action_my_app_management_dashboard"
            model="ir.actions.act_window">
        <field name="name">Management Dashboard</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_my_app_dashboard_list"/>
    </record>

    <!-- Management Dashboard Menu -->
    <menuitem id="menu_my_app_management_dashboard"
              name="Management Dashboard"
              parent="my_app.menu_my_app_root"
              action="action_my_app_management_dashboard"
              sequence="20"
              groups="my_app.group_my_app_manager"/>

</odoo>
