<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- INVENTORY WORK QUEUE LIST -->
    <record id="view_my_app_inventory_list" model="ir.ui.view">
        <field name="name">my_app.inventory.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="Inventory Work Queue">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="create_date"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- INVENTORY WORK QUEUE FORM -->
    <record id="view_my_app_inventory_form" model="ir.ui.view">
        <field name="name">my_app.inventory.form</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <form string="Inventory Work Queue">
                <header>
                    <button name="action_claim_order"
                            type="object"
                            string="Claim Order"
                            invisible="assigned_user_id != False and assigned_user_id != uid"/>

                    <button name="action_start_processing"
                            type="object"
                            string="Start Processing"
                            class="btn-primary"
                            invisible="state != 'new'"/>

                    <button name="action_add_products"
                            type="object"
                            string="Add Products"
                            class="btn-primary"
                            invisible="state != 'processing'"/>

                    <button name="action_ready_to_ship"
                            type="object"
                            string="Ready to Ship"
                            class="btn-primary"
                            invisible="state != 'adding_products'"/>

                    <button name="action_dispatch"
                            type="object"
                            string="Dispatch"
                            class="btn-primary"
                            invisible="state != 'ready_to_ship'"/>

                    <button name="action_deliver"
                            type="object"
                            string="Mark Delivered"
                            class="btn-primary"
                            invisible="state != 'dispatched'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,processing,adding_products,ready_to_ship,dispatched,delivered"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Order Information">
                            <field name="retailer_id" readonly="True"/>
                            <field name="department" readonly="True"/>
                            <field name="assigned_user_id"/>
                        </group>

                        <group string="Order Details">
                            <field name="create_date" readonly="True"/>
                            <field name="write_date" readonly="True"/>
                            <field name="amount_total" readonly="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids"
                                   readonly="state in ['ready_to_ship', 'dispatched', 'delivered']">
                                <list>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>

                        <page string="Status History">
                            <field name="history_ids" readonly="True">
                                <list>
                                    <field name="changed_on"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="changed_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- INVENTORY WORK QUEUE ACTION -->
    <record id="action_my_app_inventory_orders"
            model="ir.actions.act_window">
        <field name="name">Inventory Work Queue</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id"
               ref="my_app.view_my_app_order_search"/>
        <field name="domain">[('state', 'in', ['new', 'processing', 'adding_products', 'ready_to_ship', 'dispatched', 'delivered'])]</field>
    </record>

    <!-- INVENTORY LIST VIEW -->
    <record id="action_my_app_inventory_orders_list_view"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_my_app_inventory_list"/>
        <field name="act_window_id"
               ref="action_my_app_inventory_orders"/>
    </record>

    <!-- INVENTORY FORM VIEW -->
    <record id="action_my_app_inventory_orders_form_view"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_my_app_inventory_form"/>
        <field name="act_window_id"
               ref="action_my_app_inventory_orders"/>
    </record>

    <!-- INVENTORY WORK QUEUE MENU -->
    <menuitem id="menu_my_app_inventory_orders"
              name="Inventory Work Queue"
              parent="my_app.menu_my_app_root"
              action="action_my_app_inventory_orders"
              sequence="15"
              groups="base.group_system,my_app.group_my_app_manager,my_app.group_my_app_inventory"/>

</odoo>
