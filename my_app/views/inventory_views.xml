<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- ===================================================== -->
    <!-- INVENTORY CHECK LIST VIEW                             -->
    <!-- ===================================================== -->
    <record id="view_my_app_inventory_list" model="ir.ui.view">
        <field name="name">my_app.inventory.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="Inventory Check">
                <field name="name"/>
                <field name="retailer_id"/>
                <field name="create_date"/>
                <field name="department"/>
                <field name="assigned_user_id"/>
                <field name="amount_total"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- INVENTORY CHECK FORM VIEW                             -->
    <!-- ===================================================== -->
    <record id="view_my_app_inventory_form" model="ir.ui.view">
        <field name="name">my_app.inventory.form</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <form string="Inventory Check">
                <header>
                    <button name="action_claim_order"
                            type="object"
                            string="Claim Order"
                            class="btn-primary"/>

                    <button name="action_start_inventory_check"
                            type="object"
                            string="Start Inventory Check"
                            class="btn-primary"/>

                    <button name="action_inventory_checked"
                            type="object"
                            string="Inventory Checked"
                            class="btn-primary"/>

                    <button name="action_put_on_hold"
                            type="object"
                            string="Put On Hold"/>

                    <button name="action_resume_order"
                            type="object"
                            string="Resume Order"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,checking_inventory,inventory_checked,pending_stock,processing,completed,on_hold"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="True"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Order Information">
                            <field name="retailer_id" readonly="True"/>
                            <field name="department" readonly="True"/>
                            <field name="assigned_user_id"/>
                        </group>

                        <group string="Order Details">
                            <field name="create_date" readonly="True"/>
                            <field name="amount_total" readonly="True"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line_ids" readonly="True">
                                <list>
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="price_subtotal"/>
                                </list>
                            </field>
                        </page>

                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- INVENTORY CHECK ACTION                                -->
    <!-- Excludes Ready to Ship and Shipped orders             -->
    <!-- ===================================================== -->
    <record id="action_my_app_inventory_orders" model="ir.actions.act_window">
        <field name="name">Inventory Check</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_my_app_inventory_list"/>
        <field name="search_view_id" ref="my_app.view_my_app_order_search"/>
        <field name="domain">
            [('state', 'in', ['new', 'checking_inventory', 'inventory_checked', 'pending_stock', 'processing', 'completed', 'on_hold'])]
        </field>
        <field name="context">{}</field>
    </record>

    <!-- ===================================================== -->
    <!-- INVENTORY CHECK MENU                                  -->
    <!-- ===================================================== -->
    <menuitem id="menu_my_app_inventory_orders"
              name="Inventory Check"
              parent="my_app.menu_my_app_root"
              action="action_my_app_inventory_orders"
              sequence="15"
              groups="base.group_system,my_app.group_my_app_manager,my_app.group_my_app_inventory"/>

</odoo>
