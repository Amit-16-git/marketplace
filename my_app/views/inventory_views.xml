<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Inventory Orders List -->
    <record id="view_my_app_inventory_list" model="ir.ui.view">
        <field name="name">my_app.order.inventory.list</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <list string="New Orders for Inventory"
                  create="false"
                  edit="false"
                  delete="false">
                <field name="name" string="Order Number"/>
                <field name="retailer_id" string="Retailer"/>
                <field name="create_date" string="Created Time"/>
                <field name="state" string="Status"/>
                <field name="assigned_user_id" string="Assigned Staff"/>
            </list>
        </field>
    </record>

    <!-- Inventory Order Form -->
    <record id="view_my_app_inventory_form" model="ir.ui.view">
        <field name="name">my_app.order.inventory.form</field>
        <field name="model">my_app.order</field>
        <field name="arch" type="xml">
            <form string="Inventory Order" create="false" delete="false">
                <header>
                    <button name="action_claim_order"
                            type="object"
                            string="Claim Order"
                            class="btn-secondary"
                            invisible="assigned_user_id and assigned_user_id != uid"/>

                    <button name="action_start_inventory_check"
                            type="object"
                            string="Start Inventory Check"
                            class="btn-primary"
                            invisible="state != 'new'"/>

                    <button name="action_inventory_checked"
                            type="object"
                            string="Mark Inventory Checked"
                            class="btn-primary"
                            invisible="state != 'checking_inventory'"/>

                    <button name="action_pending_stock"
                            type="object"
                            string="Mark Pending Stock"
                            class="btn-secondary"
                            invisible="state != 'checking_inventory'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,checking_inventory,inventory_checked,pending_stock"/>
                </header>

                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="retailer_id" readonly="1"/>
                            <field name="department" readonly="1"/>
                        </group>
                        <group>
                            <field name="assigned_user_id" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                            <field name="write_date" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Products">
                            <field name="order_line_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="rate"/>
                                    <field name="subtotal"/>
                                </list>
                            </field>
                        </page>

                        <page string="Status History">
                            <field name="history_ids" readonly="1">
                                <list create="false" edit="false" delete="false">
                                    <field name="changed_on"/>
                                    <field name="old_state"/>
                                    <field name="new_state"/>
                                    <field name="changed_by_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                    <group>
                        <field name="amount_total" readonly="1"/>
                        <field name="hold_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Inventory Orders Action: show only New orders -->
    <record id="action_my_app_inventory_orders" model="ir.actions.act_window">
        <field name="name">Inventory Check</field>
        <field name="res_model">my_app.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'new')]</field>
        <field name="context">{}</field>
    </record>

    <!-- Use the inventory list view for this action -->
    <record id="action_my_app_inventory_orders_list"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="view_my_app_inventory_list"/>
        <field name="act_window_id" ref="action_my_app_inventory_orders"/>
    </record>

    <!-- Use the inventory form view for this action -->
    <record id="action_my_app_inventory_orders_form"
            model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_my_app_inventory_form"/>
        <field name="act_window_id" ref="action_my_app_inventory_orders"/>
    </record>

    <!-- Inventory Check Menu: Administrator and My App Manager -->
    <menuitem id="menu_my_app_inventory_orders"
              name="Inventory Check"
              parent="my_app.menu_my_app_root"
              action="action_my_app_inventory_orders"
              sequence="15"
              groups="base.group_system,my_app.group_my_app_manager"/>

</odoo>
